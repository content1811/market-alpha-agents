# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every key below is free-tier / free-registration as of
# 2026-08-26 -- see docs/plan/section_data_pipeline.md section 1 for what each
# one unlocks and its current rate limits.

# US equities (fallback/cross-check sources; yfinance itself needs no key)
ALPHA_VANTAGE_API_KEY=
TWELVEDATA_API_KEY=
TIINGO_API_KEY=
FINNHUB_API_KEY=

# Japan / TSE equities
JQUANTS_API_KEY=
EDINET_SUBSCRIPTION_KEY=

# Crypto (CCXT/Binance/CoinGecko public endpoints need no key; add if you
# later want higher-tier CoinGecko or Dune Analytics access)
COINGECKO_API_KEY=
DUNE_API_KEY=
ETHERSCAN_API_KEY=

# Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM -- Rakuten AI Gateway (Claude via internal gateway), same pattern as
# ../Server_failure/rakuten-failure-agent. See agents/llm_client.py for the
# live-verified construction quirks (no temperature param, max_tokens=128000,
# streaming required, auth via header not api_key).
RAKUTEN_API_KEY=
RAKUTEN_BASE_URL=
LLM_MODEL=claude-sonnet-5
TEMP=0.0

# Optional local fallback (Ollama, no key needed, already pulled: qwen2.5:7b)
OLLAMA_BASE_URL=http://localhost:11434
