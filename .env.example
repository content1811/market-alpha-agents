# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every key below is free-tier / free-registration as of
# 2026-08-26 -- see docs/plan/section_data_pipeline.md section 1 for what each
# one unlocks and its current rate limits.

# US equities (fallback/cross-check sources; yfinance itself needs no key)
ALPHA_VANTAGE_API_KEY=
TWELVEDATA_API_KEY=
TIINGO_API_KEY=
FINNHUB_API_KEY=

# Japan / TSE equities
JQUANTS_API_KEY=
EDINET_SUBSCRIPTION_KEY=

# Crypto (CCXT/Binance/CoinGecko public endpoints need no key; add if you
# later want higher-tier CoinGecko or Dune Analytics access). Alternative.me's
# Fear&Greed Index (data/connectors/alternative_me.py) is free and keyless --
# no env var needed for it.
COINGECKO_API_KEY=
DUNE_API_KEY=
ETHERSCAN_API_KEY=
# DefiLlama's unlock/emissions calendar (data/connectors/defillama_unlocks.py)
# -- verified live 2026-08-31 that this is now Pro-API-only (paid); the old
# free /emissions path returns HTTP 402 "Upgrade to the paid API plan at
# https://defillama.com/subscription". Register at https://defillama.com/pro
# if you want this trigger live; leave blank to leave upcoming_unlock() unfed.
DEFILLAMA_API_KEY=

# Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord backup channel (Server Settings -> Integrations -> Webhooks ->
# New Webhook -> Copy Webhook URL)
DISCORD_WEBHOOK_URL=

# Email (EOD/monthly digest). Gmail: smtp.gmail.com:587 with an App Password,
# not your real password -- https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO_ADDRESS=

# LLM -- Rakuten AI Gateway (Claude via internal gateway), same pattern as
# ../Server_failure/rakuten-failure-agent. See agents/llm_client.py for the
# live-verified construction quirks (no temperature param, max_tokens=128000,
# streaming required, auth via header not api_key).
RAKUTEN_API_KEY=
RAKUTEN_BASE_URL=
LLM_MODEL=claude-sonnet-5
TEMP=0.0

# Optional local fallback (Ollama, no key needed, already pulled: qwen2.5:7b)
OLLAMA_BASE_URL=http://localhost:11434
